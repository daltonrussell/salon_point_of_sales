+ipcMain.handle("update-bundle", async (event, { id, ...updateData }) => {
+  try {
+    const existingBundle = db.get("bundles").find({ id }).value();
+
+    if (!existingBundle) {
+      throw new Error(`Bundle with ID ${id} not found`);
+    }
+
+    // If components or quantity changed, validate inventory
+    if (updateData.components || updateData.quantity) {
+      const components = updateData.components || existingBundle.components;
+      const quantity = updateData.quantity !== undefined ? updateData.quantity : existingBundle.quantity;
+
+      for (const component of components) {
+        const inventoryItem = db
+          .get("inventory")
+          .find({ id: component.inventoryId })
+          .value();
+
+        if (!inventoryItem) {
+          throw new Error(`Product with ID ${component.inventoryId} not found`);
+        }
+
+        // Calculate reserved quantity excluding this bundle
+        const otherBundles = db
+          .get("bundles")
+          .filter(b => b.showInUI === true && b.id !== id)
+          .value();
+
+        let reservedByOthers = 0;
+        otherBundles.forEach(bundle => {
+          const comp = bundle.components.find(c => c.inventoryId === component.inventoryId);
+          if (comp) {
+            reservedByOthers += comp.quantity * bundle.quantity;
+          }
+        });
+
+        const availableQuantity = inventoryItem.quantity - reservedByOthers;
+        const requiredQuantity = component.quantity * quantity;
+
+        if (availableQuantity < requiredQuantity) {
+          throw new Error(
+            `Insufficient inventory for ${inventoryItem.productName}. ` +
+            `Available: ${availableQuantity}, Required: ${requiredQuantity}`
+          );
+        }
+      }
+
+      // Enrich components with latest inventory data
+      if (updateData.components) {
+        updateData.components = updateData.components.map(component => {
+          const inventoryItem = db
+            .get("inventory")
+            .find({ id: component.inventoryId })
+            .value();
+
+          return {
+            inventoryId: component.inventoryId,
+            quantity: component.quantity,
+            productName: inventoryItem.productName,
+            purchasePrice: inventoryItem.purchasePrice,
+            salePrice: inventoryItem.salePrice,
+          };
+        });
+      }
+    }
+
+    db.get("bundles")
+      .find({ id })
+      .assign({
+        ...updateData,
+        updatedAt: new Date(),
+      })
+      .write();
+
+    return db.get("bundles").find({ id }).value();
+  } catch (error) {
+    log("Error updating bundle:", error);
+    throw error;
+  }
+});
+
+ipcMain.handle("delete-bundle", async (event, { id }) => {
