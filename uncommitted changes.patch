+// Helper function to calculate reserved quantity for an inventory item
+function getReservedQuantity(inventoryId) {
+  try {
+    const bundles = db.get("bundles").filter({ showInUI: true }).value();
+    let reserved = 0;
+
+    bundles.forEach(bundle => {
+      const component = bundle.components.find(c => c.inventoryId === inventoryId);
+      if (component) {
+        reserved += component.quantity * bundle.quantity;
+      }
+    });
+
+    return reserved;
+  } catch (error) {
+    log("Error calculating reserved quantity:", error);
+    return 0;
+  }
+}
+
+// Helper function to get bundles that use a specific product
+function getBundlesUsingProduct(inventoryId) {
+  try {
+    const bundles = db.get("bundles").filter({ showInUI: true }).value();
+    return bundles.filter(bundle =>
+      bundle.components.some(c => c.inventoryId === inventoryId)
+    );
+  } catch (error) {
+    log("Error getting bundles using product:", error);
+    return [];
+  }
+}
