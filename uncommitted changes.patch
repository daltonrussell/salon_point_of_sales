+ipcMain.handle("create-bundle", async (event, bundleData) => {
+  try {
+    // Validate components have sufficient inventory
+    for (const component of bundleData.components) {
+      const inventoryItem = db
+        .get("inventory")
+        .find({ id: component.inventoryId })
+        .value();
+
+      if (!inventoryItem) {
+        throw new Error(`Product with ID ${component.inventoryId} not found`);
+      }
+
+      const currentReserved = getReservedQuantity(component.inventoryId);
+      const availableQuantity = inventoryItem.quantity - currentReserved;
+      const requiredQuantity = component.quantity * bundleData.quantity;
+
+      if (availableQuantity < requiredQuantity) {
+        throw new Error(
+          `Insufficient inventory for ${inventoryItem.productName}. ` +
+          `Available: ${availableQuantity}, Required: ${requiredQuantity}`
+        );
+      }
+    }
+
+    // Create bundle with cached component details
+    const enrichedComponents = bundleData.components.map(component => {
+      const inventoryItem = db
+        .get("inventory")
+        .find({ id: component.inventoryId })
+        .value();
+
+      return {
+        inventoryId: component.inventoryId,
+        quantity: component.quantity,
+        productName: inventoryItem.productName,
+        purchasePrice: inventoryItem.purchasePrice,
+        salePrice: inventoryItem.salePrice,
+      };
+    });
+
+    const bundle = {
+      id: generateId(),
+      bundleName: bundleData.bundleName,
+      sku: bundleData.sku,
+      salePrice: bundleData.salePrice,
+      calculatedPrice: bundleData.calculatedPrice,
+      quantity: bundleData.quantity,
+      components: enrichedComponents,
+      showInUI: true,
+      createdAt: new Date(),
+      updatedAt: new Date(),
+    };
+
+    db.get("bundles").push(bundle).write();
+    return bundle;
+  } catch (error) {
+    log("Error creating bundle:", error);
+    throw error;
+  }
+});
