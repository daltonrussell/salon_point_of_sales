+    const bundle = db.get("bundles").find({ id }).value();
+
+    if (!bundle) {
+      throw new Error(`Bundle with ID ${id} not found`);
+    }
+
+    // Soft delete - just set showInUI to false
+    // This automatically "releases" reserved inventory
+    db.get("bundles")
+      .find({ id })
+      .assign({
+        showInUI: false,
+        updatedAt: new Date(),
+      })
+      .write();
+
+    return { success: true };
+  } catch (error) {
+    log("Error deleting bundle:", error);
+    throw error;
+  }
+});
